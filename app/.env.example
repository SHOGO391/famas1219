# Public browser configuration for YOUR Supabase project (set before building).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# For an existing project, NEXT_PUBLIC_SUPABASE_ANON_KEY is also supported.
# Never use service_role, sb_secret_* or a database password here.
